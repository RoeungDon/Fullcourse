    routes: [
        {
            path: "/",
            redirect: { name: "auth.signin" },
        },
        {
            path: "/signin",
            name: "auth.signin",
            component: Signin,
        },
        {
            path: "/signout",
            name: "auth.signout",
            component: Signout,
        },
        {
            path: "/signup",
            name: "auth.signup",
            component: Signup,
        },
        {
            path: "/dashboard",
            name: "dashboard",
            component: Dashboard,
        },
        {
            path: "/:pathMatch(.*)*",
            redirect: { name: "dashboard" },
        },
    ],